{
  "name": "@angel-gp/dsh-client-ui-gitpeek",
  "version": "0.1.0",
  "description": "只读的 GitHub 数据查看面板：Actions 运行、Commits、Releases 三列并排，作为 DSH 会话的第三个标签页。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "github",
    "actions",
    "releases",
    "commits",
    "ui",
    "cordis"
  ],
  "author": "Angel-GP",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angel-GP/dsh-gitpeek.git"
  },
  "homepage": "https://github.com/Angel-GP/dsh-gitpeek#readme",
  "bugs": {
    "url": "https://github.com/Angel-GP/dsh-gitpeek/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7"
  },
  "license": "MIT"
}
